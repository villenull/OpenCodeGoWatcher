#!/usr/bin/python3
# omarchy:summary=Start, watch, or cancel the Omniscience eval
# omarchy:args=[start|status|cancel|run] [question-limit]
# omarchy:hidden=true
"""Drive the AA-Omniscience evaluation of every free model.

A run is 100 questions x N free models x 2 LLM calls — about 400 calls and
7-10 minutes, all free. `start` validates the request, writes the initial
state, and hands the work to a detached process, so closing the window or
reloading the shell cannot kill a run in progress. The window then polls
`status` and reads progress from the state file.
"""

from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "lib"))

from ffa import eval as eval_mod  # noqa: E402


def main() -> int:
  parser = argparse.ArgumentParser(description="Start, watch, or cancel the Omniscience eval")
  parser.add_argument("action", choices=["start", "status", "cancel", "run"])
  parser.add_argument("limit", nargs="?", type=int, help="questions per model (default: 100)")
  parser.add_argument("--model", action="append", dest="models", help="grade only this free model (repeatable)")
  args = parser.parse_args()

  if args.action == "status":
    print(json.dumps(eval_mod.read_state(), separators=(",", ":")))
    return 0

  if args.action == "cancel":
    state = eval_mod.read_state()
    if not state.get("running"):
      print("no eval run is in progress", file=sys.stderr)
      return 1
    eval_mod.request_cancel()
    print("cancelling; the run stops after the calls in flight finish")
    return 0

  if args.action == "run":
    # Internal: the detached process `start` spawns. Not a user-facing verb.
    eval_mod.run(args.limit, args.models)
    return 0

  try:
    started = eval_mod.start(args.limit, args.models)
  except Exception as error:  # noqa: BLE001 - shown in the window
    print(f"opencode-go-watcher-free-for-all-eval: {error}", file=sys.stderr)
    return 1

  print(json.dumps(started, separators=(",", ":")))
  return 0


if __name__ == "__main__":
  raise SystemExit(main())
