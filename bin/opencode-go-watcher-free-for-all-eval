#!/usr/bin/python3
# omarchy:summary=Start, watch, or cancel the SciCode benchmark
# omarchy:args=[start|status|cancel|verify|run] [--model <id>]...
# omarchy:hidden=true
"""Drive the SciCode benchmark of every free model.

A run is SciCode's 288 scored sub-problems per free model: one LLM call each,
plus running the code it writes against SciCode's tests — an hour or more per
model, all free. The first run also downloads SciCode's test data (1 GB) and
its Python packages (~150 MB). `start` validates the request, writes the
initial state, and hands the work to a detached process, so closing the window
or reloading the shell cannot kill a run in progress; an interrupted run picks
up where it stopped. The window polls `status`.

`verify` runs SciCode's official practice solutions through the same harness:
they should pass (48 of 50 do; two are broken in SciCode's own data).
"""

from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "lib"))

from ffa import eval as eval_mod, scicode  # noqa: E402


def main() -> int:
  parser = argparse.ArgumentParser(description="Start, watch, or cancel the SciCode benchmark")
  parser.add_argument("action", choices=["start", "status", "cancel", "verify", "run"])
  parser.add_argument("--model", action="append", dest="models", help="benchmark only this free model (repeatable)")
  args = parser.parse_args()

  if args.action == "status":
    print(json.dumps(eval_mod.read_state(), separators=(",", ":")))
    return 0

  if args.action == "cancel":
    state = eval_mod.read_state()
    if not state.get("running"):
      print("no SciCode run is in progress", file=sys.stderr)
      return 1
    eval_mod.request_cancel()
    print("cancelling; the run stops after the steps in flight finish, and resumes from there next time")
    return 0

  if args.action == "verify":
    passed, total = scicode.verify()
    print(f"{passed}/{total} official practice solutions pass")
    return 0

  if args.action == "run":
    # Internal: the detached process `start` spawns. Not a user-facing verb.
    eval_mod.run(args.models)
    return 0

  try:
    started = eval_mod.start(args.models)
  except Exception as error:  # noqa: BLE001 - shown in the window
    print(f"opencode-go-watcher-free-for-all-eval: {error}", file=sys.stderr)
    return 1

  print(json.dumps(started, separators=(",", ":")))
  return 0


if __name__ == "__main__":
  raise SystemExit(main())
