#!/usr/bin/python3
# omarchy:summary=Print the free-model charts snapshot as JSON
# omarchy:args=[--force]
# omarchy:hidden=true
"""Build the snapshot the free-for-all window draws, and print it as JSON.

Reads the opencode Go catalogue, the Artificial Analysis website, the last
speed probe, and the newest SciCode result per model, then merges them into
the two charts. Cached for six hours; the AA page itself is cached for a day.
"""

from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "lib"))

from ffa import dashboard  # noqa: E402


def main() -> int:
  parser = argparse.ArgumentParser(description="Print the free-model charts snapshot as JSON")
  parser.add_argument("--force", action="store_true", help="ignore the six-hour cache")
  args = parser.parse_args()

  try:
    snapshot = dashboard.build_snapshot(force=args.force)
  except Exception as error:  # noqa: BLE001 - the window shows this as a warning
    print(f"opencode-go-watcher-free-for-all: {error}", file=sys.stderr)
    return 1

  print(json.dumps(snapshot, separators=(",", ":")))
  return 0


if __name__ == "__main__":
  raise SystemExit(main())
