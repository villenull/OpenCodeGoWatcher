#!/usr/bin/python3
# omarchy:summary=Measure output speed for every free OpenCode Go model
# omarchy:args=[--model <id>]...
# omarchy:hidden=true
"""Measure output tokens/second for each free model and cache the result.

Three samples per model, median, with the measurement window starting at the first
byte so time-to-first-token is excluded — that is how Artificial Analysis
measures it, and it is the only reason the two numbers can share one axis.
"""

from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "lib"))

from ffa import opencode, speed  # noqa: E402


def main() -> int:
  parser = argparse.ArgumentParser(description="Measure output speed for every free OpenCode Go model")
  parser.add_argument("--model", action="append", dest="models", help="probe this id instead of the free catalogue")
  args = parser.parse_args()

  model_ids = args.models
  if not model_ids:
    try:
      model_ids = [model["id"] for model in opencode.filter_free(opencode.fetch_go_models())]
    except Exception as error:  # noqa: BLE001
      print(f"opencode-go-watcher-free-for-all-speed: {error}", file=sys.stderr)
      return 1

  if not model_ids:
    print("opencode-go-watcher-free-for-all-speed: no free models to probe", file=sys.stderr)
    return 1

  print(f"probing {len(model_ids)} model(s)…", file=sys.stderr)
  payload = speed.save_rows(speed.probe_speed(model_ids))
  print(json.dumps(payload, indent=2))
  return 0


if __name__ == "__main__":
  raise SystemExit(main())
