#!/bin/bash
# omarchy:summary=Remove the OpenCode Go record and cache left by the watcher
# omarchy:hidden=true
# `omarchy plugin remove` deletes the checkout and the shell.json entry, but it
# cannot know that this plugin published a record into a directory the stock
# agents panel treats as its own. The record outlives the plugin, and the panel
# keeps drawing it — frozen at whatever it said when the service last ran.
#
# Run this BEFORE `omarchy plugin remove`, because the plugin's own copy of this
# script goes away with the checkout.

set -euo pipefail

STATE_HOME="${XDG_STATE_HOME:-$HOME/.local/state}"
CACHE_HOME="${XDG_CACHE_HOME:-$HOME/.cache}"
CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
USAGE_DIR="$STATE_HOME/omarchy/agents/usage"
RECORD="$USAGE_DIR/opencode-go.json"
CACHE_GLOB="$CACHE_HOME/omarchy/agent-usage/opencode-go-"
CHARTS_DIR="$STATE_HOME/opencode-go-watcher/free-for-all"

removed=0

if [[ -f $RECORD ]]; then
  rm -v "$RECORD"
  removed=1
fi

# The scan cache, the stale-limits cache, and everything the free-model charts
# accumulate: the snapshot, the speed probe, the SciCode results and run state,
# and SciCode's test data and Python environment (~1.2 GB). All of it is
# re-derivable, so it goes.
if [[ -d $CHARTS_DIR ]]; then
  rm -rv "$CHARTS_DIR"
  removed=1
fi

# Leftovers from earlier releases, and any bare cache entries.
shopt -s nullglob
stale=("$CACHE_HOME"/omarchy/agent-usage/opencode-go-*)
shopt -u nullglob
if (( ${#stale[@]} > 0 )); then
  rm -v -- "${stale[@]}"
  removed=1
fi

if (( removed == 0 )); then
  echo "opencode-go-watcher-uninstall: nothing of the watcher's was left behind"
else
  echo "removed the watcher's record, charts data, and cache"
fi

# The one thing that is not ours to delete: your Artificial Analysis key.
settings="$CONFIG_HOME/opencode-go-watcher/settings.json"
if [[ -e $settings ]]; then
  echo
  echo "left in place, because it is a credential and not ours to remove:"
  echo "  $settings"
  echo "delete it by hand if you want the configuration gone too"
fi

cat <<'NEXT'

Now drop the plugin itself:

  omarchy plugin remove io.github.villenull.opencode-go-watcher

Run this script first: once the checkout is gone, so is this script.
NEXT
