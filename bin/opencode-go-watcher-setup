#!/usr/bin/python3
# omarchy:summary=Set up the OpenCode Go Watcher (AA key, status, speed probe)
# omarchy:args=[--status] [--set-aa-key KEY] [--clear-aa-key] [--probe-speed]
# omarchy:hidden=true
"""Interactive setup for the free-model charts.

Run this after `omarchy plugin add`. The charts work without it — the speed
probe reads the opencode key you already have — but Artificial Analysis is what
fills the intelligence chart, and the free tier needs a key:

    https://artificialanalysis.ai/data-api

The key is prompted for with echo off, validated against the real endpoint
before it is written, and stored at 0600 in
`~/.config/opencode-go-watcher/settings.json`. It is never printed back, never
logged, and never passed on a command line — `--set-aa-key` exists for scripted
use but puts the key in your shell history, so prefer the prompt.
"""

from __future__ import annotations

import argparse
import getpass
import json
import sys
import urllib.error
import urllib.request
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "lib"))

from ffa import aa, opencode, speed, store  # noqa: E402


def head(text: str) -> None:
  print(f"\n\033[1m{text}\033[0m" if sys.stdout.isatty() else f"\n{text}")


def ok(text: str) -> None:
  print(f"  \033[32m✓\033[0m {text}" if sys.stdout.isatty() else f"  ok  {text}")


def bad(text: str) -> None:
  print(f"  \033[31m✗\033[0m {text}" if sys.stdout.isatty() else f"  ✗   {text}")


def note(text: str) -> None:
  print(f"    {text}")


def check_key(key: str) -> tuple[bool, str]:
  """Validate against the real endpoint. 429 counts as valid: the key works,
  the free tier's hourly budget is simply spent."""
  request = urllib.request.Request(
    "https://artificialanalysis.ai/api/v2/language/models/free",
    headers={"x-api-key": key, "accept": "application/json", "user-agent": store.USER_AGENT},
  )
  try:
    with urllib.request.urlopen(request, timeout=30) as response:
      body = json.load(response)
  except urllib.error.HTTPError as error:
    if error.code == 401:
      return False, "Artificial Analysis rejected the key (401)."
    if error.code == 403:
      return False, "That key is not allowed to read the data API (403)."
    if error.code == 429:
      return True, "valid, but the free tier's 100 requests/24h are spent right now"
    return False, f"Artificial Analysis returned HTTP {error.code}."
  except Exception as error:  # noqa: BLE001
    return False, f"could not reach Artificial Analysis: {error}"

  rows = body.get("data") if isinstance(body, dict) else None
  count = len(rows) if isinstance(rows, list) else 0
  if not count:
    return False, "the endpoint answered but returned no models — the key may be wrong."
  return True, f"valid, {count} models readable"


def show_status() -> None:
  head("Configuration")

  auth = store.opencode_key()
  if auth:
    ok(f"opencode Go key — {auth[1]}")
  else:
    bad("no opencode Go key")
    note("Sign in to opencode (any opencode-go model), or export OPENCODE_API_KEY.")

  aa_key = store.aa_api_key()
  if aa_key:
    ok("Artificial Analysis key — configured")
    note("from the watcher settings file" if store.read_settings().get("aaApiKey")
         else "from AA_API_KEY in the environment")
  else:
    bad("no Artificial Analysis key")
    note("Without it the intelligence chart is empty and the speed chart has")
    note("nothing to scale against. Get one at https://artificialanalysis.ai/data-api")

  speed_cache = store.read_data("speed")
  probed = speed_cache.get("probedAt") if isinstance(speed_cache, dict) else None
  if probed:
    rows = speed_cache.get("rows") or []
    measured = [row for row in rows if row.get("tokensPerSecond") is not None]
    ok(f"speed probe — {len(measured)}/{len(rows)} models measured, last {probed[:19].replace('T', ' ')}Z")
  else:
    bad("speed never probed")
    note("The window's Measure speed button does this on demand.")

  head("Where things live")
  note(f"settings   {store.settings_path()}  (0600)")
  note(f"data       {store.data_dir()}")


def prompt_for_key() -> int:
  if not sys.stdin.isatty():
    bad("no terminal to prompt on")
    note("Run this from a terminal, or pass --set-aa-key.")
    return 1

  head("Artificial Analysis API key")
  note("Get one at https://artificialanalysis.ai/data-api — the free tier allows")
  note("100 requests per 24 h, and one snapshot build costs up to twelve.")
  note("Leave it empty to skip.")

  try:
    key = getpass.getpass("\n  AA API key: ").strip()
  except (KeyboardInterrupt, EOFError):
    print()
    return 1

  if not key:
    note("Skipped. The charts work without it, minus the intelligence data.")
    return 0

  print("\n  Checking…")
  valid, message = check_key(key)
  if not valid:
    bad(message)
    note("Nothing was written.")
    return 1

  ok(f"key accepted — {message}")
  store.write_settings({"aaApiKey": key})
  # 0600, and say so: this file now holds a credential.
  store.settings_path().chmod(0o600)
  ok(f"saved to {store.settings_path()} (mode 0600)")

  note("It is never printed back, never logged, and never passed to a subprocess.")
  return 0


def main() -> int:
  parser = argparse.ArgumentParser(description="Set up the OpenCode Go Watcher")
  parser.add_argument("--status", action="store_true", help="show what is configured and change nothing")
  parser.add_argument("--set-aa-key", metavar="KEY", help="set the key non-interactively (leaves shell history)")
  parser.add_argument("--clear-aa-key", action="store_true", help="remove the stored key")
  parser.add_argument("--probe-speed", action="store_true", help="measure output speed now")
  args = parser.parse_args()

  if args.status:
    show_status()
    return 0

  if args.clear_aa_key:
    current = store.read_settings()
    if "aaApiKey" not in current:
      note("no stored key to remove")
      return 0
    current.pop("aaApiKey")
    store.write_settings(current)
    ok("removed the Artificial Analysis key")
    show_status()
    return 0

  if args.set_aa_key:
    valid, message = check_key(args.set_aa_key)
    if not valid:
      bad(message)
      return 1
    store.write_settings({"aaApiKey": args.set_aa_key})
    store.settings_path().chmod(0o600)
    ok(f"key accepted — {message}")
    show_status()
    return 0

  if args.probe_speed:
    auth = store.opencode_key()
    if not auth:
      bad("no opencode Go key, so there is nothing to measure against")
      return 1
    free = opencode.filter_free(opencode.fetch_go_models())
    if not free:
      bad("opencode Go is serving no free models right now")
      return 1
    head(f"Probing {len(free)} free model(s) — this spends a little Go quota")
    rows = speed.probe_speed([model["id"] for model in free])
    from datetime import datetime, timezone
    payload = {"probedAt": datetime.now(timezone.utc).isoformat(), "rows": rows}
    store.write_data("speed", payload)
    for row in rows:
      if row.get("tokensPerSecond") is not None:
        note(f"{row['opencodeId']}: {row['tokensPerSecond']} tok/s over ~{row.get('tokens')} tokens")
      else:
        bad(f"{row['opencodeId']}: {row.get('error', 'no measurement')}")
    return 0

  if not sys.stdin.isatty():
    show_status()
    return 0

  result = prompt_for_key()
  show_status()
  if result == 0 and store.aa_api_key():
    head("Next")
    note("Open the charts with the Free-model charts & eval button in the")
    note("OpenCode Go tab, or:")
    note("  omarchy-shell shell summon io.github.villenull.opencode-go-watcher '{}'")
  return result


if __name__ == "__main__":
  raise SystemExit(main())
