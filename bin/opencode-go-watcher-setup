#!/usr/bin/python3
# omarchy:summary=Check the OpenCode Go Watcher's setup (keys, grader, speed probe)
# omarchy:args=[--status] [--probe-speed] [--clear-aa-key]
# omarchy:hidden=true
"""Setup check for the free-model charts.

Nothing needs configuring. Artificial Analysis figures come from their public
website, the free models answer with the opencode Go key you already have, and
the Omniscience grader is Big Pickle on OpenCode Zen, reached through the
`opencode` CLI because Zen's free tier only serves OpenCode itself. This
reports whether each of those is in place.

`--clear-aa-key` removes an Artificial Analysis API key stored by an older
version, which no longer uses it.
"""

from __future__ import annotations

import argparse
import shutil
import subprocess
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "lib"))

from ffa import eval as eval_mod, opencode, speed, store  # noqa: E402


def head(text: str) -> None:
  print(f"\n\033[1m{text}\033[0m" if sys.stdout.isatty() else f"\n{text}")


def ok(text: str) -> None:
  print(f"  \033[32m✓\033[0m {text}" if sys.stdout.isatty() else f"  ok  {text}")


def bad(text: str) -> None:
  print(f"  \033[31m✗\033[0m {text}" if sys.stdout.isatty() else f"  ✗   {text}")


def note(text: str) -> None:
  print(f"    {text}")


def zen_signed_in(opencode_bin: str) -> bool:
  try:
    listed = subprocess.run([opencode_bin, "auth", "list"], capture_output=True, text=True, timeout=30)
  except (OSError, subprocess.TimeoutExpired):
    return False
  return "OpenCode Zen" in listed.stdout


def show_status() -> None:
  head("Setup")

  auth = store.opencode_key()
  if auth:
    ok(f"opencode Go key — {auth[1]}")
  else:
    bad("no opencode Go key")
    note("The free models answer with it. Run `opencode auth login` and choose OpenCode Go.")

  opencode_bin = shutil.which("opencode")
  if not opencode_bin:
    bad("the opencode CLI is not on PATH")
    note("The Omniscience grader runs through it.")
  elif zen_signed_in(opencode_bin):
    ok(f"grader — {eval_mod.GRADER_MODEL} via {opencode_bin}")
  else:
    bad("not signed in to OpenCode Zen")
    note(f"The grader, {eval_mod.GRADER_MODEL}, is free on Zen. Run `opencode auth login` and choose OpenCode Zen.")

  speed_cache = store.read_data("speed")
  probed = speed_cache.get("probedAt") if isinstance(speed_cache, dict) else None
  if probed:
    rows = speed_cache.get("rows") or []
    measured = [row for row in rows if row.get("tokensPerSecond") is not None]
    ok(f"speed probe — {len(measured)}/{len(rows)} models measured, last {probed[:19].replace('T', ' ')}Z")
  else:
    bad("speed never measured")
    note("The window's Measure speed button does this on demand.")

  history = store.read_eval_history()
  if history:
    ok(f"Omniscience — {len({grade.get('opencodeId') for grade in history})} model(s) graded, "
       f"last {str(history[0].get('finishedAt', ''))[:19].replace('T', ' ')}Z")
  else:
    bad("Omniscience never run")
    note("The window's Run Omniscience button does this.")

  if store.read_settings().get("aaApiKey"):
    note("An Artificial Analysis API key from an older version is still stored and")
    note("no longer used. `--clear-aa-key` removes it.")

  head("Where things live")
  note(f"settings   {store.settings_path()}")
  note(f"data       {store.data_dir()}")


def main() -> int:
  parser = argparse.ArgumentParser(description="Check the OpenCode Go Watcher's setup")
  parser.add_argument("--status", action="store_true", help="show the setup and change nothing (the default)")
  parser.add_argument("--probe-speed", action="store_true", help="measure output speed now")
  parser.add_argument("--clear-aa-key", action="store_true", help="remove an unused Artificial Analysis key")
  args = parser.parse_args()

  if args.clear_aa_key:
    current = store.read_settings()
    if "aaApiKey" not in current:
      note("no stored key to remove")
      return 0
    current.pop("aaApiKey")
    store.write_settings(current)
    ok("removed the Artificial Analysis key")
    return 0

  if args.probe_speed:
    if not store.opencode_key():
      bad("no opencode Go key, so there is nothing to measure against")
      return 1
    free = opencode.filter_free(opencode.fetch_go_models())
    if not free:
      bad("opencode Go is serving no free models right now")
      return 1
    head(f"Measuring {len(free)} free model(s)")
    rows = speed.probe_speed([model["id"] for model in free])
    speed.save_rows(rows)
    for row in rows:
      if row.get("tokensPerSecond") is not None:
        note(f"{row['opencodeId']}: {row['tokensPerSecond']} tok/s over ~{row.get('tokens')} tokens")
      else:
        bad(f"{row['opencodeId']}: {row.get('error', 'no measurement')}")
    return 0

  show_status()
  return 0


if __name__ == "__main__":
  raise SystemExit(main())
